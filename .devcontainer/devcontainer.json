{
  "name": "baby-equipment",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  // Mount the checkout at its *host* path rather than the default /workspaces/<repo>.
  // Claude Code keys per-project state by the working-directory path, so a container
  // that sees a different path sees an empty project. Aligning the two makes the host
  // and container agents share one project identity.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,consistency=cached",
  "workspaceFolder": "${localWorkspaceFolder}",
  // No host config is mounted here on purpose. This file describes the project, not
  // the machine. The agent CLIs, shell profile and credentials come from ~/code/util,
  // injected at launch by `dcs`/`dcr`, which mount credentials per-file so a
  // container's own plugins and settings cannot write back over the host's.
  // Start this container with `dcr` (or `dcs` to reuse a running one).
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  },
  "remoteUser": "vscode"
}
